# Copy to .env and fill in. .env is git-ignored; never commit real values.

# ---------- n8n ----------
N8N_ENCRYPTION_KEY=          # openssl rand -hex 32   (encrypts n8n's stored credentials; keep it stable)
N8N_PUBLIC_URL=http://localhost:5678/   # deploy_all.sh sets this to the tunnel URL
LOCAL_PG_PASSWORD=postgres

# ---------- application database (what n8n workflows read/write) ----------
# Local mode: the compose Postgres.  AWS mode: the RDS endpoint from `serverless info` + sslmode=require
APP_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/loan_engine
# For scripts on your machine (migrate, local ingest): same DB as seen from the host
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/loan_engine

# ---------- doorbell (Lambda/local script → n8n workflow B) ----------
N8N_WEBHOOK_URL=http://localhost:5678/webhook/batch-loaded   # AWS: <tunnel URL>/webhook/batch-loaded
N8N_WEBHOOK_SECRET=          # openssl rand -hex 32 — same value as SSM /loan-engine/webhook-secret

# ---------- LLM (any OpenAI-compatible API) ----------
# OpenAI:    LLM_BASE_URL=https://api.openai.com/v1                                  LLM_MODEL=gpt-4o-mini
# Gemini:    LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai    LLM_MODEL=gemini-2.5-flash
# Anthropic: LLM_BASE_URL=https://api.anthropic.com/v1                               LLM_MODEL=claude-haiku-5-5
# Groq:      LLM_BASE_URL=https://api.groq.com/openai/v1                              LLM_MODEL=llama-3.3-70b-versatile
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_ENABLED=true

# ---------- email (SES) ----------
SES_REGION=ap-south-1
SES_FROM_EMAIL=              # your Gmail, verified as an SES identity
SES_ACCESS_KEY_ID=           # access key of the SesSenderUser IAM user (send-only)
SES_SECRET_ACCESS_KEY=
# The brief: never email sample-CSV addresses. In TEST_MODE every recipient is rewritten to one of
# these aliases (each must be verified in SES while the account is in the sandbox).
TEST_MODE=true
TEST_RECIPIENTS=yourname+one@gmail.com,yourname+two@gmail.com,yourname+three@gmail.com
MAX_EMAILS_PER_RUN=3
UNSUBSCRIBE_BASE_URL=        # https://<api-id>.execute-api.ap-south-1.amazonaws.com/dev/v1/unsubscribe
UNSUBSCRIBE_SECRET=          # openssl rand -hex 32 — same value as SSM /loan-engine/unsubscribe-secret

# ---------- deploy-time (serverless) ----------
DB_ALLOWED_CIDR=0.0.0.0/0

# --- Tunnel (AWS → n8n on this machine). Optional: without these, a Cloudflare quick tunnel is used,
# whose URL changes on every restart (then re-run scripts/deploy_all.sh). With them the URL is fixed.
NGROK_AUTHTOKEN=             # ngrok dashboard → Your Authtoken
NGROK_DOMAIN=                # ngrok dashboard → Domains → your free *.ngrok-free.dev domain
